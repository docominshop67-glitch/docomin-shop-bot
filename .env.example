# Discord Bot Token (นำมาจาก https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_token_here

# Prefix สำหรับคำสั่งพิมพ์ธรรมดา (เช่น !p, !ask)
PREFIX=!

# Google Gemini API Key สำหรับระบบปัญญาประดิษฐ์
GEMINI_API_KEY=your_gemini_api_key_here

# พอร์ตสำหรับ Web Dashboard (Cloud จะกำหนดให้อัตโนมัติ)
PORT=3000

# อนุญาตการเชื่อมต่อ TLS
NODE_TLS_REJECT_UNAUTHORIZED=0
